# ─────────────────────────────────────────────────────────────
# CoFoundr environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://cofoundr:cofoundr@localhost:5432/cofoundr?schema=public"

# Auth.js (generate: `npx auth secret` or `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email (for verification / password reset). Optional in dev — links are
# logged to the console when SMTP is not configured.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="CoFoundr <no-reply@cofoundr.local>"

# Storage — local filesystem by default. Set provider to "cloudinary" to use Cloudinary.
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Realtime (Pusher) — optional. When unset, messaging falls back to polling.
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# Cron (weekly leaderboard snapshot). Vercel injects this as a Bearer token.
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
